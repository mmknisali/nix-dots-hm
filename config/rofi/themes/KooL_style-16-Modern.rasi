/* ---- 💫 https://github.com/JaKooLit 💫 ---- */
/* KooL Hyprland Rofi Style 16 - Modern */
/* credit: https://github.com/adi1090x/rofi */

/* A floating command-bar launcher.
 * The palette is Catppuccin Mocha, the same one the waybar uses, so the
 * desktop reads as one system instead of three unrelated greys. */

/*****----- Configuration -----*****/
configuration {
    modi:                       "drun,run,filebrowser,window";
    show-icons:                 true;
    display-drun:               "  apps";
    display-run:                "  term";
    display-filebrowser:        "  files";
    display-window:             "  window";
    drun-display-format:        "{name}";
    window-format:              "{w}  ·  {c}  ·  {t}";
    hover-select:               true;
    me-select-entry:            "MouseSecondary";
    me-accept-entry:            "MousePrimary";

    /* Rofi 2.0 supports fzf ranking, not the newer fzf-v2 method. */
    matching:                   "fuzzy,normal";
    sorting-method:             "fzf";
    sort:                       true;
    tokenize:                   true;
    case-sensitive:             false;
    normalize-match:            true;
    drun-match-fields:          "name,generic,exec,categories,keywords";
}

/*****----- Palette (Catppuccin Mocha) -----*****/
* {
    base:        #1e1e2e;
    crust:       #11111b;
    mantle:      #181825;
    surface0:    #313244;
    surface1:    #45475a;
    surface2:    #585b70;
    overlay0:    #6c7086;
    overlay1:    #7f849c;
    text:        #cdd6f4;
    subtext0:    #a6adc8;
    subtext1:    #9399b2;
    accent:      #89b4fa;
    urgent:      #f38ba8;
}

/*****----- Global Properties -----*****/
* {
    background-color:            @base;
    foreground-color:            @text;
    normal-background:           transparent;
    normal-foreground:           @subtext0;
    active-background:           transparent;
    active-foreground:           @text;
    urgent-background:           transparent;
    urgent-foreground:           @urgent;
    alternate-normal-background: transparent;
    alternate-normal-foreground: @subtext1;
    alternate-active-background: transparent;
    alternate-active-foreground: @text;
    alternate-urgent-background: transparent;
    alternate-urgent-foreground: @urgent;
    selected-normal-background:  @surface0;
    selected-normal-foreground:  @text;
    selected-active-background:  @surface0;
    selected-active-foreground:  @text;
    selected-urgent-background:  @surface0;
    selected-urgent-foreground:  @text;
    border-color:                @surface1;
    handle-color:                @accent;
    separatorcolor:              @surface1;
}

/*****----- Main Window -----*****/
window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       46%;
    x-offset:                    0px;
    y-offset:                    0px;

    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border:                      0px;
    border-radius:               14px;
    background-color:            transparent;
    cursor:                      "default";
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    spacing:                     12px;
    margin:                      0px;
    padding:                     16px;
    border:                      1px;
    border-radius:               14px;
    border-color:                @surface1;
    background-color:            @base;
    children:                    [ "inputbar", "message", "listview", "textbox-footer" ];
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     10px 12px;
    border:                      1px;
    border-radius:               10px;
    border-color:                @surface0;
    background-color:            @mantle;
    text-color:                  @text;
    children:                    [ "prompt", "entry" ];
}

prompt {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  @accent;
}

textbox-prompt-colon {
    enabled:                     false;
}

entry {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  @text;
    placeholder-color:           @subtext1;
    cursor:                      "text";
    placeholder:                 "Search…";
}

/* The current mode is shown by the prompt, the footer mentions the mode key. */

/*****----- Listview -----*****/
listview {
    enabled:                     true;
    columns:                     1;
    lines:                       8;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   true;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                false;
    fixed-columns:               true;

    spacing:                     2px;
    margin:                      0px;
    padding:                     0px;
    border:                      0px;
    border-radius:               10px;
    background-color:            transparent;
    text-color:                  @subtext0;
    cursor:                      "default";
}

scrollbar {
    handle-width:                3px;
    handle-color:                @surface2;
    border-radius:               3px;
    background-color:            transparent;
}

/*****----- Elements -----*****/
element {
    enabled:                     true;
    spacing:                     12px;
    margin:                      0px;
    padding:                     7px 10px;
    border:                      0px;
    border-radius:               8px;
    border-color:                transparent;
    background-color:            transparent;
    text-color:                  @subtext0;
    orientation:                 horizontal;
    cursor:                      "pointer";
}

element normal.normal {
    background-color:            transparent;
    text-color:                  @subtext0;
}

element normal.active {
    background-color:            transparent;
    text-color:                  @text;
}

element normal.urgent {
    background-color:            transparent;
    text-color:                  @urgent;
}

element selected.normal,
element selected.active,
element selected.urgent {
    background-color:            @surface0;
    text-color:                  @text;
}

element-icon {
    background-color:            transparent;
    text-color:                  inherit;
    size:                        24px;
    cursor:                      "inherit";
    vertical-align:              0.5;
}

element-icon selected {
    text-color:                  @accent;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    highlight:                   inherit;
    cursor:                      "inherit";
    vertical-align:              0.5;
    horizontal-align:            0.0;
    margin:                      0px;
    padding:                     0px;
}

/*****----- Message -----*****/
message {
    background-color:            transparent;
    border:                      0px;
    margin:                      0px;
    padding:                     0px;
}

error-message {
    background-color:            transparent;
    border:                      0px;
    padding:                     0px;
    text-color:                  @urgent;
}

textbox, textbox-footer {
    background-color:            transparent;
    border:                      0px;
    border-radius:               0px;
    padding:                     2px 4px;
    margin:                      0px;
    text-color:                  @text;
    vertical-align:              0.5;
    horizontal-align:            0.0;
    highlight:                   none;
}

textbox-footer {
    expand:                      false;
    text-color:                  @overlay0;
    str:                         "Enter  open     Ctrl+Tab  mode     Esc  close";
}
